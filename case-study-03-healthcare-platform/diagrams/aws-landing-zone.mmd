graph TD
    root["AWS Organization<br/>Meridian Health Network"]

    root --> security["OU: Security"]
    root --> infra["OU: Infrastructure"]
    root --> workloads["OU: Workloads"]
    root --> sandbox["OU: Sandbox"]

    security --> logarchive["Account: meridian-log-archive<br/><i>CloudTrail, Config, GuardDuty<br/>findings -- write-once from every<br/>other account</i>"]
    security --> audit["Account: meridian-audit<br/><i>Security Hub aggregation,<br/>read-only cross-account access</i>"]

    infra --> network["Account: meridian-network<br/><i>Primary region (us-east-1) --<br/>Transit Gateway, Inspection VPC,<br/>Network Firewall, Direct Connect<br/>Gateway -- shared by every workload</i>"]
    infra --> networkdr["Account: meridian-network-dr<br/><i>DR region (us-west-2) --<br/>DR Transit Gateway, DR Inspection VPC,<br/>DR Network Firewall</i>"]
    infra --> identity["Account: meridian-identity<br/><i>AWS Directory Service trust,<br/>IAM Identity Center</i>"]

    workloads --> corp["OU: Corp (internal line-of-business)"]
    corp --> prodapp["Account: meridian-healthcare-prod-app<br/><i>Application VPC -- API Gateway,<br/>ECS Fargate, Citrix EC2, Lambda</i>"]
    corp --> proddata["Account: meridian-healthcare-prod-data<br/><i>Data VPC -- RDS Custom, FSx,<br/>S3 Gateway endpoints</i>"]
    corp --> nonprod["Account: meridian-healthcare-nonprod<br/><i>Dev/Test/UAT copies of the<br/>same landing zone pattern,<br/>CI/CD runners</i>"]
    corp --> drapp["Account: meridian-healthcare-dr-app<br/><i>DR Application VPC -- AWS DRS-replicated<br/>Citrix EC2, ECS Fargate, Lambda</i>"]
    corp --> drdata["Account: meridian-healthcare-dr-data<br/><i>DR Data VPC -- DMS warm-standby<br/>SQL Server target</i>"]
    corp --> drshared["Account: meridian-healthcare-dr-shared<br/><i>DR Shared Services VPC -- monitoring/<br/>logging, backup</i>"]

    classDef ou fill:#F3E8FD,stroke:#5B2C87,color:#5B2C87,font-weight:bold;
    classDef acct fill:#DCEBFC,stroke:#2E6DA4,color:#1F4E79;
    classDef root fill:#EAD1F7,stroke:#674EA7,color:#3B1F5C,font-weight:bold;

    class root root;
    class security,infra,workloads,sandbox,corp ou;
    class logarchive,audit,network,networkdr,identity,prodapp,proddata,nonprod,drapp,drdata,drshared acct;
