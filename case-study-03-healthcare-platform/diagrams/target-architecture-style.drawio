<mxfile host="app.diagrams.net">
  <diagram name="Target Architecture Style - Step 4" id="step4-target-style">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Meridian Health Network -- Target Architecture Style (Step 4 Sketch)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Precursor to the Step 5 logical design -- pattern-level, not platform-specific&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="640" height="50" as="geometry" />
        </mxCell>

        <!-- Patients -->
        <mxCell id="patients" value="Patients / Referring Providers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="260" height="40" as="geometry" />
        </mxCell>

        <!-- Zero Trust boundary (sent to back) -->
        <mxCell id="ztBoundary" value="ZERO TRUST OVERLAY -- verify identity, device, and context on every request&lt;br&gt;(cross-cutting: applies to everything inside this boundary, not a step in the flow)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#B8860B;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#B8860B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="150" width="960" height="330" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="gateway" value="API Gateway&lt;br&gt;(single entry point, enforces auth on every call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFC;strokeColor=#2E6DA4;" vertex="1" parent="1">
          <mxGeometry x="470" y="200" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- Row: Bus, Portal, Telehealth, CareLink -->
        <mxCell id="bus" value="Integration Bus&lt;br&gt;(event-driven, pub/sub --&lt;br&gt;replaces LinkEngine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFC;strokeColor=#2E6DA4;" vertex="1" parent="1">
          <mxGeometry x="170" y="330" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="portal" value="Portal&lt;br&gt;(rebuilt, API-first)&lt;br&gt;&lt;b&gt;Refactor&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#38761D;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="telehealth" value="Telehealth&lt;br&gt;(repurchased, API-native)&lt;br&gt;&lt;b&gt;Repurchase&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B45F06;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="carelink" value="CareLink PM&lt;br&gt;(replatformed, system of record)&lt;br&gt;&lt;b&gt;Replatform&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#A61C00;" vertex="1" parent="1">
          <mxGeometry x="880" y="330" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- External systems -->
        <mxCell id="external" value="LabCorp / Quest / Hospital PACS / Surescripts&lt;br&gt;(external systems)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- Shared services platform -->
        <mxCell id="platform" value="Shared-Services / Landing-Zone Platform&lt;br&gt;self-service provisioning for new &amp;amp; acquired clinics -- golden path, not bespoke VPN engineering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAD1F7;strokeColor=#674EA7;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="660" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="html=1;endArrow=block;" edge="1" parent="1" source="patients" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="event-driven (pub/sub)" style="html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="gateway" target="bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="html=1;endArrow=block;" edge="1" parent="1" source="gateway" target="portal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="html=1;endArrow=block;" edge="1" parent="1" source="gateway" target="telehealth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="html=1;endArrow=block;" edge="1" parent="1" source="gateway" target="carelink">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="HL7 / API events" style="html=1;endArrow=block;" edge="1" parent="1" source="bus" target="external">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="runs on" style="html=1;endArrow=block;dashed=1;strokeColor=#674EA7;" edge="1" parent="1" source="bus" target="platform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="html=1;endArrow=block;dashed=1;strokeColor=#674EA7;" edge="1" parent="1" source="portal" target="platform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="html=1;endArrow=block;dashed=1;strokeColor=#674EA7;" edge="1" parent="1" source="telehealth" target="platform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="html=1;endArrow=block;dashed=1;strokeColor=#674EA7;" edge="1" parent="1" source="carelink" target="platform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
