digraph AWSNetworkAddressing {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  nodesep=0.35;
  ranksep=0.5;
  node [fontname="Helvetica", fontsize=9, shape=plaintext];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  labelloc="t";
  label="Meridian Health Network -- AWS Network Addressing Plan (Step 7)\nTransit Gateway hub-and-spoke, primary region (us-east-1) -- see ADR-014\nEvery subnet is AZ-scoped (AWS constraint) -- multi-AZ tiers get one subnet per AZ, not one shared subnet";
  fontsize=15;

  subgraph cluster_hub {
    label="INSPECTION VPC (HUB)  --  10.10.0.0/16";
    style="filled"; fillcolor="#E7F0FA"; color="#2E6DA4"; fontcolor="#1F4E79"; fontsize=12;

    node [style="rounded,filled", shape=box, fillcolor="#FFFFFF", color="#2E6DA4"];
    tgw1 [label=<<B>subnet-tgw-attach-az1</B><BR/>10.10.0.0/28>];
    tgw2 [label=<<B>subnet-tgw-attach-az2</B><BR/>10.10.0.16/28>];
    tgw3 [label=<<B>subnet-tgw-attach-az3</B><BR/>10.10.0.32/28>];
    fw1 [label=<<B>subnet-firewall-az1</B><BR/>10.10.1.0/27>];
    fw2 [label=<<B>subnet-firewall-az2</B><BR/>10.10.1.32/27>];
    fw3 [label=<<B>subnet-firewall-az3</B><BR/>10.10.1.64/27>];
    vpnsub [label=<<B>subnet-vpn-dx</B><BR/>10.10.2.0/27<BR/>attaches to TGW directly, not AZ-scoped>];

    tgw1 -> tgw2 -> tgw3 -> fw1 -> fw2 -> fw3 -> vpnsub [style=invis];
  }

  subgraph cluster_app {
    label="APPLICATION VPC  --  10.20.0.0/16  (3 AZs, Transit Gateway attached)";
    style="filled"; fillcolor="#EAF6EC"; color="#38761D"; fontcolor="#274E13"; fontsize=12;

    node [style="rounded,filled", shape=box, fillcolor="#FFFFFF", color="#38761D"];
    sg1 [shape=note, fillcolor="#FFF2CC", color="#B45F06", fontsize=9, label=<<B>SG -- ecs-portal-tasks</B><BR/>Allow 443 in from ALB SG only>];
    sg2 [shape=note, fillcolor="#FFF2CC", color="#B45F06", fontsize=9, label=<<B>SG -- citrix-vda</B><BR/>Allow HDX in from Cloud Connector SG<BR/>SSM Session Manager for admin access>];
    sg4 [shape=note, fillcolor="#FFF2CC", color="#B45F06", fontsize=9, label=<<B>SG -- lambda-linkengine</B><BR/>Outbound only to sns-sqs, rds, s3 endpoint>];

    apigw1 [label=<<B>subnet-apigw-vpclink-az1</B><BR/>10.20.1.0/26>];
    apigw2 [label=<<B>subnet-apigw-vpclink-az2</B><BR/>10.20.1.64/26>];
    apigw3 [label=<<B>subnet-apigw-vpclink-az3</B><BR/>10.20.1.128/26>];

    ecs1 [label=<<B>subnet-ecs-portal-az1</B><BR/>10.20.2.0/26>];
    ecs2 [label=<<B>subnet-ecs-portal-az2</B><BR/>10.20.2.64/26>];
    ecs3 [label=<<B>subnet-ecs-portal-az3</B><BR/>10.20.2.128/26>];

    cit1 [label=<<B>subnet-citrix-az1</B><BR/>10.20.3.0/26>];
    cit2 [label=<<B>subnet-citrix-az2</B><BR/>10.20.3.64/26>];
    cit3 [label=<<B>subnet-citrix-az3</B><BR/>10.20.3.128/26>];

    sns1 [label=<<B>subnet-sns-sqs-az1</B><BR/>10.20.4.0/26>];
    sns2 [label=<<B>subnet-sns-sqs-az2</B><BR/>10.20.4.64/26>];
    sns3 [label=<<B>subnet-sns-sqs-az3</B><BR/>10.20.4.128/26>];

    lam1 [label=<<B>subnet-lambda-linkengine-az1</B><BR/>10.20.5.0/26>];
    lam2 [label=<<B>subnet-lambda-linkengine-az2</B><BR/>10.20.5.64/26>];
    lam3 [label=<<B>subnet-lambda-linkengine-az3</B><BR/>10.20.5.128/26>];

    cc1 [label=<<B>subnet-cloud-connectors-az1</B><BR/>10.20.6.0/27>];
    cc2 [label=<<B>subnet-cloud-connectors-az2</B><BR/>10.20.6.32/27>];
    cc3 [label=<<B>subnet-cloud-connectors-az3</B><BR/>10.20.6.64/27<BR/>(spare connector lands here)>];

    sg1 -> sg2 -> sg4 [style=invis];
    sg4 -> apigw1 [style=invis];
    apigw1 -> apigw2 -> apigw3 -> ecs1 -> ecs2 -> ecs3 -> cit1 -> cit2 -> cit3 -> sns1 -> sns2 -> sns3 -> lam1 -> lam2 -> lam3 -> cc1 -> cc2 -> cc3 [style=invis];
  }

  subgraph cluster_data {
    label="DATA VPC  --  10.30.0.0/16  (2 AZs -- RDS Multi-AZ only needs 2, Transit Gateway attached)";
    style="filled"; fillcolor="#FDF2E9"; color="#B45F06"; fontcolor="#7F4C0A"; fontsize=12;

    node [style="rounded,filled", shape=box, fillcolor="#FFFFFF", color="#B45F06"];
    sg3 [shape=note, fillcolor="#FFF2CC", color="#B45F06", fontsize=9, label=<<B>SG -- rds-custom-sqlserver</B><BR/>Allow 1433 in from citrix, ecs-portal,<BR/>lambda-linkengine SGs only>];
    rdsaz1 [label=<<B>subnet-rds-az1</B><BR/>10.30.1.0/25<BR/>RDS Custom -- AZ1>];
    rdsaz2 [label=<<B>subnet-rds-az2</B><BR/>10.30.1.128/25<BR/>RDS Custom -- AZ2>];
    vpce1 [label=<<B>subnet-vpc-endpoints-az1</B><BR/>10.30.2.0/25<BR/>Secrets Manager + CloudWatch>];
    vpce2 [label=<<B>subnet-vpc-endpoints-az2</B><BR/>10.30.2.128/25<BR/>(S3 = Gateway endpoint, no subnet IP used)>];

    sg3 -> rdsaz1 -> rdsaz2 -> vpce1 -> vpce2 [style=invis];
  }

  subgraph cluster_dr {
    label="DR REGION MIRROR (us-west-2)  --  10.110.0.0/16, 10.120.0.0/16, 10.130.0.0/16\nsame per-AZ subnet pattern, non-overlapping ranges so networks can route during failover";
    style="filled,dashed"; fillcolor="#FCEFEF"; color="#A61C00"; fontcolor="#85200C"; fontsize=11;
    drnote [shape=plaintext, fontsize=10, label="Inspection VPC-DR 10.110.0.0/16  |  App VPC-DR 10.120.0.0/16  |  Data VPC-DR 10.130.0.0/16"];
  }

  rt [shape=note, style=filled, fillcolor="#E0D6F5", color="#5B2C87", fontsize=9,
    label=<<B>Route table on both spoke VPCs</B><BR/>0.0.0.0/0 next hop = Transit Gateway<BR/>routes to Inspection VPC Network Firewall<BR/>then NAT/IGW -- forces all egress through hub>];

  fw2 -> sg1 [label="  via Transit Gateway  ", color="#333333"];
  apigw2 -> rdsaz1 [label="  private VPC path  ", style=dashed, color="#333333"];
  rt -> fw2 [style=dashed, color="#5B2C87", constraint=false];
}
