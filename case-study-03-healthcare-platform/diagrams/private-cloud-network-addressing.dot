digraph PrivateCloudNetworkAddressing {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  nodesep=0.35;
  ranksep=0.5;
  node [fontname="Helvetica", fontsize=9, shape=plaintext];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  labelloc="t";
  label="Meridian Health Network -- Private-Cloud (VMware Cloud Foundation) Network Addressing Plan (Step 9)\nNSX Tier-0 hub + Tier-1 spokes, primary facility (Columbus, OH) -- see ADR-029\nAn NSX segment has no AZ/regional scoping the way a hyperscaler subnet does -- one segment per tier, full stop";
  fontsize=15;

  subgraph cluster_hub {
    label="MANAGEMENT SEGMENT (NSX TIER-0 HUB)  --  10.10.0.0/16";
    style="filled"; fillcolor="#E7F0FA"; color="#2E6DA4"; fontcolor="#1F4E79"; fontsize=12;

    node [style="rounded,filled", shape=box, fillcolor="#FFFFFF", color="#2E6DA4"];
    mgmt [label=<<B>segment-mgmt</B><BR/>10.10.0.0/24<BR/>vCenter, NSX Manager cluster,<BR/>SDDC Manager, Aria Suite>];
    edge1 [label=<<B>segment-edge</B><BR/>10.10.1.0/24<BR/>NSX Edge cluster --<BR/>Tier-0/Tier-1 gateways, Avi LB>];

    mgmt -> edge1 [style=invis];
  }

  subgraph cluster_app {
    label="APPLICATION SEGMENT (TIER-1 SPOKE)  --  10.20.0.0/16";
    style="filled"; fillcolor="#EAF6EC"; color="#38761D"; fontcolor="#274E13"; fontsize=12;

    node [style="rounded,filled", shape=box, fillcolor="#FFFFFF", color="#38761D"];
    dfw1 [shape=note, fillcolor="#FFF2CC", color="#B45F06", fontsize=9, label=<<B>NSX Distributed Firewall</B><BR/>Portal Tanzu pods: allow 443 in from<BR/>Avi LB only. Citrix VDA: allow HDX in<BR/>from Cloud Connector segment only>];

    apigw [label=<<B>segment-app (shared)</B><BR/>10.20.1.0/24<BR/>API gateway runtime>];
    portal [label=<<B>segment-app (shared)</B><BR/>10.20.1.0/24<BR/>Portal Tanzu Deployments>];
    citrix [label=<<B>segment-app (shared)</B><BR/>10.20.1.0/24<BR/>Citrix VDA session hosts<BR/>+ Cloud Connectors>];

    dfw1 -> apigw [style=invis];
    apigw -> portal -> citrix [style=invis];
  }

  subgraph cluster_integration {
    label="INTEGRATION SEGMENT (TIER-1 SPOKE)  --  10.50.0.0/16\nisolated for trust-boundary reasons, not IP capacity -- see ADR-030";
    style="filled"; fillcolor="#FFF4E5"; color="#B45F06"; fontcolor="#7F4C0A"; fontsize=12;

    node [style="rounded,filled", shape=box, fillcolor="#FFFFFF", color="#B45F06"];
    linkengine [label=<<B>segment-integration</B><BR/>10.50.1.0/24<BR/>Tanzu: Publish Service +<BR/>4 subscriber Deployments>];
  }

  subgraph cluster_data {
    label="DATA SEGMENT (TIER-1 SPOKE)  --  10.30.0.0/16";
    style="filled"; fillcolor="#FDF2E9"; color="#B45F06"; fontcolor="#7F4C0A"; fontsize=12;

    node [style="rounded,filled", shape=box, fillcolor="#FFFFFF", color="#B45F06"];
    sqlsg [shape=note, fillcolor="#FFF2CC", color="#B45F06", fontsize=9, label=<<B>NSX Distributed Firewall</B><BR/>Allow 1433 in from app + integration<BR/>segments only, deny all else>];
    sql [label=<<B>segment-data</B><BR/>10.30.1.0/24<BR/>SQL Server Always On --<BR/>synchronous replica pair>];

    sqlsg -> sql [style=invis];
  }

  subgraph cluster_dr {
    label="DR FACILITY MIRROR (Dallas, TX)  --  10.110.0.0/16, 10.120.0.0/16, 10.130.0.0/16, 10.150.0.0/16\nprovisioned to FULL target capacity from day one (ADR-026) -- not a scaled-down pilot light";
    style="filled,dashed"; fillcolor="#FCEFEF"; color="#A61C00"; fontcolor="#85200C"; fontsize=11;
    drnote [shape=plaintext, fontsize=10, label="Mgmt-DR 10.110.0.0/16  |  App-DR 10.120.0.0/16  |  Data-DR 10.130.0.0/16  |  Integration-DR 10.150.0.0/16\n(Integration-DR built from day one -- unlike the GCP track's own flagged gap, see ADR-029)"];
  }

  rt [shape=note, style=filled, fillcolor="#E0D6F5", color="#5B2C87", fontsize=9,
    label=<<B>Tier-1 default route</B><BR/>0.0.0.0/0 next hop = Tier-0 hub<BR/>enforces NSX Distributed Firewall +<BR/>NSX Edge before internet egress>];

  edge1 -> apigw [label="  via Tier-0 hub  ", color="#333333"];
  portal -> sql [label="  private NSX fabric  ", style=dashed, color="#333333"];
  linkengine -> sql [label="  private NSX fabric  ", style=dashed, color="#333333"];
  rt -> edge1 [style=dashed, color="#5B2C87", constraint=false];
  sql -> drnote [label="  Always On async replica\n  over private inter-facility circuit  ", style=dashed, color="#A61C00", constraint=false];
}
