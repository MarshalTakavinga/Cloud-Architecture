<mxfile host="app.diagrams.net">
  <diagram name="HA-DR Logical View - Step 5" id="step5-ha-dr">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Meridian Health Network -- HA/DR Logical View&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Warm standby (pilot light) across two regions -- see ADR-004&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="0" width="600" height="50" as="geometry" />
        </mxCell>

        <mxCell id="dns" value="DNS / Traffic Routing&lt;br&gt;(manual-initiated cutover)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAD1F7;strokeColor=#674EA7;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="primaryBoundary" value="PRIMARY REGION -- active" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#38761D;verticalAlign=top;fontColor=#274E13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="pApp" value="Core PM Service +&lt;br&gt;Portal + Telehealth + Bus&lt;br&gt;(full scale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#38761D;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pDB" value="Primary Relational Database&lt;br&gt;(read/write)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9CB9C;strokeColor=#B45F06;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pStore" value="Object / Blob Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2F3;strokeColor=#0B5394;" vertex="1" parent="1">
          <mxGeometry x="340" y="290" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="secondaryBoundary" value="SECONDARY REGION -- warm standby (pilot light, reduced scale)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCEFEF;strokeColor=#A61C00;verticalAlign=top;fontColor=#85200C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="340" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sApp" value="Core PM Service +&lt;br&gt;Portal + Telehealth + Bus&lt;br&gt;(pre-provisioned, scaled down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#A61C00;" vertex="1" parent="1">
          <mxGeometry x="790" y="290" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sDB" value="Primary Relational Database&lt;br&gt;(read replica)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9CB9C;strokeColor=#B45F06;" vertex="1" parent="1">
          <mxGeometry x="790" y="110" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sStore" value="Object / Blob Storage&lt;br&gt;(replicated copy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2F3;strokeColor=#0B5394;" vertex="1" parent="1">
          <mxGeometry x="790" y="200" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Failover: manual-initiated, tooling-assisted&lt;br&gt;RTO target: &amp;lt;= 4 hours (promote + scale up + DNS cutover)&lt;br&gt;RPO target: &amp;lt;= 15 minutes (bounded by async replication interval)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B45F06;size=16;" vertex="1" parent="1">
          <mxGeometry x="1140" y="380" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="normal traffic" style="html=1;endArrow=block;" edge="1" parent="1" source="dns" target="pApp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="on failover" style="html=1;endArrow=block;dashed=1;strokeColor=#A61C00;" edge="1" parent="1" source="dns" target="sApp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="async replication, RPO &amp;lt;= 15 min" style="html=1;endArrow=block;dashed=1;strokeColor=#B45F06;" edge="1" parent="1" source="pDB" target="sDB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="continuous replication" style="html=1;endArrow=block;dashed=1;strokeColor=#0B5394;" edge="1" parent="1" source="pStore" target="sStore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
