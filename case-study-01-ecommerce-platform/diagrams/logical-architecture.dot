digraph LogicalArchitecture {
  rankdir=TB;
  fontname="Helvetica";
  labelloc="t";
  fontsize=18;
  nodesep=0.35;
  ranksep=0.55;
  label="Solstice Retail — Vendor-Neutral Logical Architecture (Step 5 / ADR-003, ADR-004)\n\lObservability Platform (distributed tracing + business signals) attaches to every service below — omitted as individual lines for legibility.\l";
  node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#EAF1FB", color="#1F4E79", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];

  Customers [label="Global Customers\n(US / EU / APAC)", shape=ellipse, fillcolor="#FFF2CC", color="#BF8F00"];
  CDN [label="CDN / Edge\n(latency-based routing)", fillcolor="#D9E2F3"];
  APIGW [label="API Gateway\n(single ingress)", fillcolor="#D9E2F3"];
  Identity [label="Identity Provider\n(customer sign-in, session)", fillcolor="#D9E2F3"];

  { rank=same; Customers }
  { rank=same; CDN }
  { rank=same; APIGW }
  { rank=same; Identity }

  subgraph cluster_catalog {
    label="Catalog — single-writer, multi-region read replicas (ADR-003)";
    fontsize=9; style="dashed"; color="#2E75B6";
    CatWrite [label="Catalog Write Path\n(merchandising / back-office)"];
    Read_US [label="Catalog Read Store (US)"];
    Read_EU [label="Catalog Read Store (EU)"];
    Read_APAC [label="Catalog Read Store (APAC)"];
    SF_US [label="Storefront & Catalog (US read)"];
    SF_EU [label="Storefront & Catalog (EU read)"];
    SF_APAC [label="Storefront & Catalog (APAC read)"];
    CatWrite -> Read_US [label="write"];
    Read_US -> Read_EU [style=dashed, label="async replication"];
    Read_US -> Read_APAC [style=dashed, label="async replication"];
    Read_US -> SF_US; Read_EU -> SF_EU; Read_APAC -> SF_APAC;
  }

  subgraph cluster_eu {
    label="Region: EU — regional-primary (ADR-003)\n(GDPR: EU data stays here)";
    fontsize=9; style="dashed"; color="#548235";
    Cart_EU [label="Cart"]; Checkout_EU [label="Checkout & Payment", fillcolor="#FCE4E4", color="#C00000"];
    Orch_EU [label="Order Orchestration"]; Store_EU [label="Regional Transactional\nStore (EU)"];
    Cart_EU -> Checkout_EU -> Orch_EU;
    Orch_EU -> Store_EU;
  }
  subgraph cluster_us {
    label="Region: US — regional-primary (ADR-003)";
    fontsize=9; style="dashed"; color="#548235";
    Cart_US [label="Cart"]; Checkout_US [label="Checkout & Payment", fillcolor="#FCE4E4", color="#C00000"];
    Orch_US [label="Order Orchestration"]; Store_US [label="Regional Transactional\nStore (US)"];
    Cart_US -> Checkout_US -> Orch_US;
    Orch_US -> Store_US;
  }
  subgraph cluster_apac {
    label="Region: APAC — regional-primary (ADR-003)";
    fontsize=9; style="dashed"; color="#548235";
    Cart_APAC [label="Cart"]; Checkout_APAC [label="Checkout & Payment", fillcolor="#FCE4E4", color="#C00000"];
    Orch_APAC [label="Order Orchestration"]; Store_APAC [label="Regional Transactional\nStore (APAC)"];
    Cart_APAC -> Checkout_APAC -> Orch_APAC;
    Orch_APAC -> Store_APAC;
  }

  Gateway [label="Payment Gateway\n(3rd-party, PCI Level 1, hosted-fields tokenization —\nreceives tokenized card data directly from the customer's\nbrowser via hosted fields, per ADR-004; bypasses\nCheckout & Payment for raw card data entirely)",
           shape=ellipse, fillcolor="#E2EFDA", color="#548235"];
  EventBus [label="Event Bus\n(order placed → inventory reserved → payment confirmed → fulfillment triggered)", fillcolor="#FFF2CC", color="#BF8F00"];
  Fulfillment [label="Fulfillment / Warehouse (existing system — out of scope)", style="rounded,dashed", fillcolor="#F2F2F2", color="#7F7F7F", fontcolor="#7F7F7F"];

  { rank=same; Gateway }
  { rank=same; EventBus }
  { rank=same; Fulfillment }

  Customers -> CDN -> APIGW;
  APIGW -> Identity;
  APIGW -> SF_US; APIGW -> SF_EU; APIGW -> SF_APAC;
  APIGW -> Cart_US; APIGW -> Cart_EU; APIGW -> Cart_APAC;

  Checkout_EU -> Gateway [label="charge (token only)"];
  Checkout_US -> Gateway [label="charge (token only)"];
  Checkout_APAC -> Gateway [label="charge (token only)"];

  Orch_EU -> EventBus; Orch_US -> EventBus; Orch_APAC -> EventBus;
  EventBus -> Fulfillment;
}
